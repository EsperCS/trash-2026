# Environment configuration template for RMIT Hackathon 2026 Security Task
# Copy this file to .env and populate with local values. Never commit secrets!

# Kaggle API Credentials (for downloading datasets / automated submissions)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Pipeline Execution Settings
SEED=42
DATA_DIR=data
OUTPUT_DIR=models
SUBMISSIONS_DIR=submissions
LOG_LEVEL=INFO

# Compute Hardware Configuration
# Options: auto, mps, cuda, cpu
DEVICE=auto
NUM_WORKERS=4

